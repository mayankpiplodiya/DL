import yfinance as yf
import numpy as np
import pandas as pd
from sklearn.preprocessing import MinMaxScaler
from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score
from statsmodels.tsa.arima.model import ARIMA
import matplotlib.pyplot as plt
import math
import warnings
warnings.filterwarnings("ignore")


# 1. Fetch Stock Data

ticker = input("Enter Stock Ticker Symbol (e.g., AAPL, MSFT, TSLA, RELIANCE.NS): ").upper()
period = input("Enter historical data period (e.g., 1y, 2y, 3y, 5y): ") or "3y"
time_step = 60
test_size = 30

df = yf.download(ticker, period=period, progress=False)
if df.empty:
    raise ValueError("Invalid Ticker or No Data Found!")

df = df[['Close']].dropna()
series = df['Close']

print(f"\n Downloaded {len(df)} records for {ticker}\n")

#2. Preprocessing

train_series = series[:-test_size]
test_series = series[-test_size:]

#  Prepare Data for LSTM

scaler = MinMaxScaler(feature_range=(0, 1))
train_scaled = scaler.fit_transform(train_series.values.reshape(-1, 1))
all_scaled = scaler.transform(series.values.reshape(-1, 1))

def create_sequences(data, time_step):
    X, y = [], []
    for i in range(time_step, len(data)):
        X.append(data[i - time_step:i, 0])
        y.append(data[i, 0])
    return np.array(X), np.array(y)

X, y = create_sequences(all_scaled, time_step)
X_train, y_train = X[:-test_size], y[:-test_size]
X_test, y_test = X[-test_size:], y[-test_size:]

X_train = X_train.reshape((X_train.shape[0], X_train.shape[1], 1))
X_test = X_test.reshape((X_test.shape[0], X_test.shape[1], 1))


from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import LSTM, Dense

# 3. LSTM Model

model = Sequential([
    LSTM(64, return_sequences=True, input_shape=(time_step, 1)),
    LSTM(64),
    Dense(1)
])
model.compile(optimizer='adam', loss='mean_squared_error')
print("\n Training LSTM model...")
model.fit(X_train, y_train, epochs=20, batch_size=32, verbose=1)


# 4. ARIMA Model
print("\n Training ARIMA model...")
arima_order = (5, 1, 0)
arima_model = ARIMA(train_series, order=arima_order)
arima_fit = arima_model.fit()
arima_forecast = arima_fit.forecast(steps=test_size)
arima_pred = np.array(arima_forecast).reshape(-1, 1)



# 5. Compare Results

def evaluate(y_true, y_pred, name):
    mse = mean_squared_error(y_true, y_pred)
    rmse = math.sqrt(mse)
    mae = mean_absolute_error(y_true, y_pred)
    r2 = r2_score(y_true, y_pred)
    print(f"{name} Performance:")
    print(f"  MSE  = {mse:.4f}")
    print(f"  RMSE = {rmse:.4f}")
    print(f"  MAE  = {mae:.4f}")
    print(f"  R²   = {r2:.4f}\n")
    return {"MSE": mse, "RMSE": rmse, "MAE": mae, "R2": r2}

# Predict with LSTM model
lstm_pred_scaled = model.predict(X_test)
# Inverse transform to get actual prices
y_test_inv = scaler.inverse_transform(y_test.reshape(-1, 1))
lstm_pred = scaler.inverse_transform(lstm_pred_scaled)

print("\n📊 Model Performance Comparison:")
lstm_metrics = evaluate(y_test_inv, lstm_pred, "LSTM")
arima_metrics = evaluate(y_test_inv, arima_pred, "ARIMA")

results_df = pd.DataFrame({
    "Date": df.index[-test_size:],
    "Actual": y_test_inv.flatten(),
    "LSTM_Pred": lstm_pred.flatten(),
    "ARIMA_Pred": arima_pred.flatten()
})
results_df.set_index("Date", inplace=True)
print("\n📈 Prediction Results (Last 5 Days):")
print(results_df.tail())


plt.figure(figsize=(12,6))
plt.plot(results_df["Actual"], label="Actual", linewidth=2)
plt.plot(results_df["LSTM_Pred"], label="LSTM Predicted", linestyle='--')
plt.plot(results_df["ARIMA_Pred"], label="ARIMA Predicted", linestyle=':')
plt.title(f"Stock Price Prediction for {ticker}")
plt.xlabel("Date")
plt.ylabel("Price")
plt.legend()
plt.grid(True)
plt.show()
